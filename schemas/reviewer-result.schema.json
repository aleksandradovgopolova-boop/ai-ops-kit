{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "reviewer-result",
  "description": "Структурный результат ревьюера (v2.33, Execution Engine Фаза 1) — ИСТОЧНИК ИСТИНЫ для гейта вместо regex по markdown. Человеческий текст генерится поверх этой структуры, а не наоборот. Reviewer кладёт рядом со стадией: <run_dir>/stage-<id>.reviewer.json; gate_executor.collect_evidence читает его первым.",
  "type": "object",
  "required": ["schema_version", "kind", "gate", "status", "checks"],
  "properties": {
    "schema_version": {"type": "integer"},
    "kind": {"const": "reviewer-result"},
    "gate": {"type": "string", "description": "id гейта из quality/gates.yaml"},
    "reviewer": {"type": "string", "description": "agent id ревьюера"},
    "reviewed_revision": {"type": "string", "description": "git sha проверенной ревизии"},
    "status": {"enum": ["pass", "warn", "fail"]},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": {"type": "string"},
          "status": {"enum": ["pass", "warn", "fail"]},
          "evidence": {
            "oneOf": [
              {"type": "object", "properties": {
                "file": {"type": "string"}, "lines": {"type": "string"}
              }},
              {"type": "array", "items": {"type": "object", "properties": {
                "file": {"type": "string"}, "lines": {"type": "string"}
              }}}
            ]
          }
        }
      }
    },
    "blockers": {"type": "array", "items": {"type": "string"},
      "description": "при status=fail — конкретные блокеры (что именно не так)"}
  },
  "definitions": {
  "model_red_team": {
    "description": "Пассивный transport фактического заключения другой модели со сверкой отдельной квитанции хоста.",
    "allOf": [{"$ref": "#"}],
    "type": "object",
    "required": ["reviewer_kind", "review_role", "review_root", "request_sha256", "managed_sha256", "config_sha256"],
    "properties": {
      "reviewer_kind": {"const": "model"},
      "review_role": {"$ref": "#/definitions/human_red_team/properties/review_role"},
      "review_root": {"$ref": "#/definitions/human_red_team/properties/review_root"},
      "managed_sha256": {"$ref": "#/definitions/human_red_team/properties/managed_sha256"},
      "config_sha256": {"$ref": "#/definitions/human_red_team/properties/config_sha256"},
      "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "attack_evidence": {"$ref": "#/definitions/human_red_team/properties/attack_evidence"}
    },
    "if": {"properties": {"status": {"const": "pass"}}, "required": ["status"]},
    "then": {"required": ["attack_evidence"], "properties": {"attack_evidence": {"minItems": 1}}}
  },
  "human_red_team": {
    "description": "Experimental human red-team fallback; нормативная other-model альтернатива не отменяется.",
    "allOf": [
      {
        "$ref": "#"
      }
    ],
    "type": "object",
    "required": [
      "reviewer_kind",
      "review_role",
      "review_root",
      "managed_sha256",
      "config_sha256"
    ],
    "properties": {
      "reviewer_kind": {
        "const": "human",
        "description": "Только внешний human fallback; не удостоверяет личность."
      },
      "review_role": {
        "const": "ai-red-teamer"
      },
      "review_root": {
        "type": "string",
        "minLength": 1
      },
      "managed_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "config_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "attack_evidence": {
        "type": "array",
        "maxItems": 32,
        "description": "Человеческий pass требует настоящие execution artifacts текущей ревизии; fixtures не подтверждают live испытание.",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path",
            "sha256",
            "tested_revision"
          ],
          "properties": {
            "kind": {
              "const": "adversarial-execution"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "tested_revision": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "if": {
      "properties": {
        "status": {
          "const": "pass"
        }
      },
      "required": [
        "status"
      ]
    },
    "then": {
      "required": [
        "attack_evidence"
      ],
      "properties": {
        "attack_evidence": {
          "minItems": 1
        }
      }
    }
  }
}
}
